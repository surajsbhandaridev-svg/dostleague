PORT=10000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
# Supabase Dashboard > Connect > Session pooler. Copy the full URI; replace only the password placeholder. Server-only.
# Session-pooler username includes the project ref and its host is an aws-<index>-<region>.pooler.supabase.com hostname.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_EXACT_POOLER_HOST:5432/postgres
SESSION_TOKEN_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
MAX_ROOM_SIZE=6
ROOM_TTL_SECONDS=3600
# Enables the moderation screen. Server-only; leave unset to disable admin routes.
# ADMIN_API_KEY=REPLACE_WITH_A_LONG_RANDOM_ADMIN_KEY
